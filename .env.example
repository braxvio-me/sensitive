# SMTP settings used by src/lib/mailer.ts for the contact, careers and
# newsletter forms. Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@braxvio.com
SMTP_PASS=
SMTP_FROM="Braxvio <no-reply@braxvio.com>"
